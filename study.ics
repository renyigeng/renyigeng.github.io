DTSTART;TZID=Asia/Shanghai:20261027T124000
DTEND;TZID=Asia/Shanghai:20261027T134500
SUMMARY:😴 午休｜把手机放一边，安心休息
DESCRIPTION:12:40停止刷手机，准备午休；尽量12:50开始休息
 ，13:40–13:50起床。起床请另设手机闹钟。\n午休不是偷
 懒，是让下午的你更有精神。手机里的内容可以等，先
 让自己舒舒服服休息一会儿。
RRULE:FREQ=DAILY
STATUS:CONFIRMED
TRANSP:OPAQUE
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:😴 午休｜把手机放一边，安心休息
TRIGGER:PT0M
END:VALARM
END:VEVENT
