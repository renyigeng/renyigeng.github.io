---
layout: null
permalink: /notes/posts.json
---
[
{% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
    "category": {{ post.category | default: "Notes" | jsonify }},
    "description": {{ post.description | default: post.excerpt | strip_html | strip_newlines | truncate: 180 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
